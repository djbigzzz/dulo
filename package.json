{
  "name": "dulo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "stats": "tsx scripts/traction-stats.ts",
    "tick:local": "tsx --env-file=.env.local scripts/local-tick.mts",
    "catalogue:build": "tsx scripts/build-xstocks-catalogue.ts",
    "postinstall": "prisma generate",
    "db:setup": "tsx scripts/deploy-db.mts",
    "db:neon": "tsx scripts/neon-env.mts",
    "env:vercel": "tsx scripts/vercel-env.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/client": "^6.19.3",
    "@solana/spl-token": "^0.4.15",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-phantom": "^0.9.30",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/wallet-adapter-solflare": "^0.6.34",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.45.0",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "prisma": "^6.19.3",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
