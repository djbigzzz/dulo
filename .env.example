# Dulo — environment template. Copy to .env.local (gitignored) and fill in; see README "Run locally" and docs/HANDOFF.md §4.3.
# Server-only keys are read by src/lib/server/env.ts; NEXT_PUBLIC_* are public (bundled into the client) — never put a secret in one.

# DATABASE_URL — Postgres. Local: a plain URL. Supabase: create the project in us-east-1 (next to Vercel's default iad1) and use
# the transaction pooler (port 6543) with `?pgbouncer=true&connection_limit=1&connect_timeout=5`, e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=5
DATABASE_URL="postgresql://postgres:password@localhost:5432/dulo?schema=public"
# Prisma CLI only (db push / migrate). Local: same as DATABASE_URL. Supabase: the SESSION pooler (port 5432,
# aws-0-us-east-1.pooler.supabase.com) — not db.<ref>.supabase.co, which is IPv6-only on the Free plan.
DIRECT_URL="postgresql://postgres:password@localhost:5432/dulo?schema=public"

HELIUS_API_KEY=""   # server-side RPC key (free tier is enough); empty = NEXT_PUBLIC_RPC below, slow and rate-limited
JUPITER_API_KEY=""   # REQUIRED in production (free at https://portal.jup.ag): keyless Jupiter throttles to ~0.5 RPS and 429s in normal click-through. Empty is fine for light local dev only
JWT_SECRET=""   # at least 32 characters; generate with: openssl rand -base64 48
CRON_SECRET="change-me-to-16-plus-random-characters"   # at least 16 characters (openssl rand -hex 16); sent as `Authorization: Bearer` by Vercel Cron and the Actions pinger — never in a URL
SERVER_WALLET_SECRET=""   # base58 (or JSON array) secret key of the badge-minting wallet; fund 0.3 SOL (~0.006 SOL per Badge). Empty = Badges stay "Minting soon"
PYTH_API_KEY=""   # optional. Hermes needs a key since 26 Aug 2026 (sign up at https://pythdata.app/signup); without one Calls settle from Jupiter and the source is shown on every card
PYTH_HERMES_URL="https://hermes.pyth.network"   # fallback host: https://pyth.dourolabs.app/hermes
XSTOCKS_API_URL="https://api.xstocks.fi/api/v2/public"
NEXT_PUBLIC_RPC="https://api.mainnet-beta.solana.com"   # public fallback RPC, used only when HELIUS_API_KEY is empty. Never put the Helius key here
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # production: https://<project>.vercel.app until dulo.fun actually resolves, then https://dulo.fun and redeploy. Baked into Badge metadata URIs at mint time; also the SIWS domain/uri fallback (auth routes derive them from the request's host headers)
NEXT_PUBLIC_APP_NAME="Dulo"
# Optional public links, baked in at build time (redeploy after changing). The footer links and the /partners "Talk to us" button
# render only when set to an https:// URL (or mailto: for the contact); empty or anything else = hidden.
NEXT_PUBLIC_GITHUB_URL=""   # https URL of the public repo; footer "GitHub" link
NEXT_PUBLIC_X_URL=""   # https URL of the X profile; footer "X" link
NEXT_PUBLIC_VIDEO_URL=""   # https URL of the demo video; footer "Watch the demo" link
NEXT_PUBLIC_PARTNER_CONTACT=""   # mailto:<address> or an https URL; /partners "Talk to us" button
